<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cursor Agent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/agent_section_header" />

        <!-- Connection status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@color/agent_soft_bg"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/agent_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="18sp"
                    android:textColor="@color/agent_gray" />

                <TextView
                    android:id="@+id/agent_status_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="Not checked"
                    android:textStyle="bold"
                    android:textColor="@color/agent_section_header" />
            </LinearLayout>

            <TextView
                android:id="@+id/agent_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tap &#8220;Test connection&#8221; to verify the bridge and agent."
                android:textSize="13sp"
                android:textColor="@color/agent_gray" />

            <Button
                android:id="@+id/agent_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Test connection" />

            <Button
                android:id="@+id/agent_install_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Show setup command" />

            <TextView
                android:id="@+id/agent_install_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Copy the command and run it in the chroot (Termux) to install the agent &amp; (re)start the bridge."
                android:textSize="12sp"
                android:textColor="@color/agent_gray" />
        </LinearLayout>

        <!-- Connection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Connection"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/agent_section_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connection type"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/agent_conn_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/agent_conn_local"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local chroot (loopback)" />

            <RadioButton
                android:id="@+id/agent_conn_external"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="External agent URL (wss:// or tls://)" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/agent_local_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bridge host"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/agent_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:hint="127.0.0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bridge port"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/agent_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:hint="9043" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/agent_external_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Agent URL"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/agent_endpoint_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:hint="wss://host | https://host | tls://host:9043" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Shared token (must match the bridge)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/agent_shared_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Set by the bridge on its side" />

            <CheckBox
                android:id="@+id/agent_tls_insecure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Allow self-signed / unverified TLS (insecure)" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Keep the keyboard unprivileged: all root-capable work (agent, context) runs on the bridge side, whether local chroot or remote."
            android:textSize="12sp"
            android:textColor="@color/agent_gray" />

        <!-- Agent -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Agent"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/agent_section_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Workspace directory"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/agent_workspace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="/" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Model (optional)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/agent_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:hint="(leave blank for default)" />

        <!-- Authentication -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Authentication"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/agent_section_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your Cursor API key is encrypted at rest with a master key you set. This device is rooted, so anyone with root can read the app&#8217;s storage &#8212; encryption keeps the key unreadable without your master key."
            android:textSize="12sp"
            android:textColor="@color/agent_gray" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cursor API key"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/agent_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="ck-&#8230; (Cursor Dashboard &#8594; API Keys)" />

        <CheckBox
            android:id="@+id/agent_api_key_show"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show key" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Master key"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/agent_master_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="At least 8 characters" />

        <TextView
            android:id="@+id/agent_auth_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No key saved"
            android:textStyle="bold"
            android:textColor="@color/agent_section_header" />

        <Button
            android:id="@+id/agent_auth_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save &amp; encrypt" />

        <!-- Behavior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Behavior"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/agent_section_header" />

        <CheckBox
            android:id="@+id/agent_auto_approve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Auto-approve tool calls" />

        <CheckBox
            android:id="@+id/agent_capture_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture shell context from the bridge" />

        <Button
            android:id="@+id/agent_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>
